{
   "$schema": "./node_modules/wrangler/config-schema.json",
   "name": "yunikov1-app",
   "main": "src/server/worker.ts",
   "compatibility_date": "2026-09-26",
   "compatibility_flags": [
      "nodejs_compat",
      "nodejs_compat_populate_process_env"
   ],
   "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS",
      "run_worker_first": true
   },
   "vars": {
      "SUPABASE_URL": "https://pqjrmtkfgwoocbvmwbby.supabase.co",
      "NEXT_PUBLIC_SUPABASE_URL": "https://pqjrmtkfgwoocbvmwbby.supabase.co",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_EcRG6tql7D2aWdCrzq3yEw_R_AJjEHV0",
      "YUNIKO_APP_URL": "https://yunikov1-app.lafatriniainaallane.workers.dev",
      "YUNIKO_API_URL": "https://yunikov1-app.lafatriniainaallane.workers.dev"
   },
   "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "redact_query_string": false,
      "logs": {
         "enabled": true,
         "head_sampling_rate": 1,
         "invocation_logs": true,
         "persist": true
      },
      "traces": {
         "enabled": true,
         "head_sampling_rate": 1,
         "persist": true
      }
   },
   "keep_vars": true
}